rules_version = '2';

// Firestore 보안 규칙 — 한화내일아카데미 출석 시스템
// -----------------------------------------------------------------------------
// 1차 구현 정책:
//  - attendances 컬렉션에 대해 create 는 누구나 가능 (교육생이 익명으로 QR 스캔 후 제출)
//    다만 문서 구조를 서버측에서 강하게 검증한다.
//  - read 는 관리자만 가능 (Firebase Authentication 로그인 필요).
//  - update, delete 는 전면 금지 (관리자 UI에서도 사용하지 않음)
service cloud.firestore {
  match /databases/{database}/documents {

    match /attendances/{docId} {

      // 읽기 권한
      //  - get  : 문서 ID 를 정확히 아는 사람만 문서 1개 조회 (학생 본인 재제출 감지용 공개 허용)
      //  - list : 컴렉션 전체 조회/쿼리 → 관리자만 허용 (명단 보호)
      allow get: if true;
      allow list: if request.auth != null;

      // 생성: 입실 또는 퇴실 중 정확히 하나만 request.time 으로 채워진 상태여야 함
      allow create: if
        request.resource.data.keys().hasAll(
          ['name', 'class', 'date', 'checkInAt', 'checkOutAt', 'createdAt', 'updatedAt']
        ) &&

        // name
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 40 &&

        // class : 문자열, 1~20자 (반 이름은 config/classNames 에서 동적으로 관리되므로 고정 목록 검증 불가)
        request.resource.data.class is string &&
        request.resource.data.class.size() > 0 &&
        request.resource.data.class.size() <= 20 &&

        // date
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&

        // createdAt / updatedAt
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&

        // checkInAt / checkOutAt : 정확히 하나만 request.time 이고 다른 하나는 null
        (
          (request.resource.data.checkInAt == request.time &&
           request.resource.data.checkOutAt == null) ||
          (request.resource.data.checkOutAt == request.time &&
           request.resource.data.checkInAt == null)
        );

      // 업데이트: 나머지 하나의 시각을 채우는 경우 (혹은 재제출 시 request.time 으로 덮어쓰기)
      // - name, class, date 는 변경 금지
      // - updatedAt == request.time
      // - 두 케이스 중 하나:
      //     (A) checkInAt 을 request.time 으로 세팅 & checkOutAt 은 기존 값 유지
      //     (B) checkOutAt 을 request.time 으로 세팅 & checkInAt 은 기존 값 유지
      allow update: if
        request.resource.data.name == resource.data.name &&
        request.resource.data.class == resource.data.class &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.updatedAt == request.time &&
        (
          (
            // (A) 입실 재/신규 기록: checkInAt 은 request.time, checkOutAt 은 기존 그대로
            request.resource.data.checkInAt == request.time &&
            request.resource.data.checkOutAt == resource.data.checkOutAt
          ) ||
          (
            // (B) 퇴실 재/신규 기록: checkOutAt 은 request.time, checkInAt 은 기존 그대로
            request.resource.data.checkOutAt == request.time &&
            request.resource.data.checkInAt == resource.data.checkInAt
          )
        );

      // 삭제: 관리자만 허용
      allow delete: if request.auth != null;
    }

    // schedules/{YYYY-MM-DD} : 날짜별 교육 시간표 (3개 반 공통)
    // - read/create/update: 관리자만 (Firebase Auth 로그인 필요)
    // - delete: 금지 (덮어쓰기 방식으로 수정)
    match /schedules/{dateId} {
      allow read: if request.auth != null;

      allow create, update: if
        request.auth != null &&
        request.resource.data.keys().hasAll(['startTime', 'endTime']) &&
        request.resource.data.startTime is string &&
        request.resource.data.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        request.resource.data.endTime is string &&
        request.resource.data.endTime.matches('^[0-9]{2}:[0-9]{2}$');

      allow delete: if false;
    }

    // config/{docId} : 반 이름 등 앱 설정
    // - read: 누구나 (학생이 attend.html 에서 로그인 없이 반 목록 읽어야 함)
    // - create/update: 관리자만
    // - delete: 금지
    match /config/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // 그 외 모든 경로는 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
